<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="10dp"
        android:layout_margin="5dp"
        app:cardElevation="4dp"
        android:clickable="false"
        android:focusable="false"
        android:foreground="?attr/selectableItemBackground">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/postClue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="@string/default_op_clue"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="100dp"
                android:layout_marginTop="10dp"
                android:maxLines="2"/>

            <RatingBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/postClue"
                android:layout_marginStart="20dp"
                android:layout_marginTop="5dp"
                style="?android:attr/ratingBarStyleSmall"
                android:scaleX="1.3"
                android:scaleY="1.3"
                android:transformPivotX="0dp"
                android:transformPivotY="0dp"
                android:id="@+id/postRatingStars"
                android:stepSize="0.5"
                android:isIndicator="true"/>

            <ImageView
                android:id="@+id/postOPPic"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginTop="11dp"
                android:layout_below="@id/postRatingStars"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_profile"/>

            <TextView
                android:id="@+id/postOP"
                android:layout_below="@id/postRatingStars"
                android:layout_toEndOf="@id/postOPPic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:clickable="true"
                android:textSize="18sp"
                android:text="@string/default_op_name"
                android:layout_marginTop="12.5dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="50dp" />

            <ImageView
                android:id="@+id/divHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_below="@id/postOP"
                android:layout_marginTop="10dp"
                android:src="@color/divider_color"
                android:layout_marginHorizontal="16dp"/>

            <ImageView
                android:id="@+id/guessImage"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="84dp"
                android:src="@drawable/baseline_question_mark_24"
                android:layout_below="@id/divHorizontal"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="70.5dp"
                android:layout_below="@id/guessImage"
                android:text="@string/guess_button"/>

            <ImageView
                android:id="@+id/commentImage"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="87dp"
                android:src="@drawable/baseline_comment_24"
                android:layout_below="@id/divHorizontal"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:layout_alignParentEnd="true"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="55dp"
                android:layout_below="@id/guessImage"
                android:text="@string/comment_button"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>