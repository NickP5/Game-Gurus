<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".StatisticsFragment">

    <TextView
        android:id="@+id/displayNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/display_name"
        android:textStyle="bold"
        android:textSize="24sp"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/recent_progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recent_progress"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/displayNameText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/recent_points_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/points_text"
        android:textSize="15sp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/recent_progress_title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/recent_points"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/temp_points"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="@id/recent_points_text"
        app:layout_constraintStart_toEndOf="@id/recent_points_text" />

    <TextView
        android:id="@+id/recent_attempts_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/attempts_text"
        android:textSize="15sp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/recent_points_text"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/recent_attempts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/temp_attempts"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="@id/recent_attempts_text"
        app:layout_constraintStart_toEndOf="@id/recent_attempts_text" />

    <TextView
        android:id="@+id/recent_correct_percent_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/percentage_text"
        android:textSize="15sp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/recent_attempts_text"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/recent_correct_percent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/temp_percent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="@id/recent_correct_percent_text"
        app:layout_constraintStart_toEndOf="@id/recent_correct_percent_text" />

    <TextView
        android:id="@+id/total_progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/total_progress"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/recent_correct_percent_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/total_points_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/points_text"
        android:textSize="15sp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/total_progress_title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/total_points"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/temp_points"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="@id/total_points_text"
        app:layout_constraintStart_toEndOf="@id/total_points_text" />

    <TextView
        android:id="@+id/total_attempts_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/attempts_text"
        android:textSize="15sp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/total_points_text"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/total_attempts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/temp_attempts"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="@id/total_attempts_text"
        app:layout_constraintStart_toEndOf="@id/total_attempts_text" />

    <TextView
        android:id="@+id/total_correct_percent_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/percentage_text"
        android:textSize="15sp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toBottomOf="@id/total_attempts_text"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/total_correct_percent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/temp_percent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="@id/total_correct_percent_text"
        app:layout_constraintStart_toEndOf="@id/total_correct_percent_text" />

</androidx.constraintlayout.widget.ConstraintLayout>