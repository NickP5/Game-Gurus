<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nav_view"
    android:padding="16dp"
    tools:context=".ProfileFragment">

    <ImageButton
        android:id="@+id/close_profile_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/close_profile"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/change_pfp_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/close_profile_button"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:src="@drawable/ic_change"
            android:contentDescription="@string/change_pfp" />

        <Spinner
            android:id="@+id/pfpSpinner"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:spinnerMode="dropdown"
            android:background="@null" />
    </LinearLayout>

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profilePic"
        android:src="@drawable/mountain"
        app:civ_border_color="@color/profile_border"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        app:civ_border_width="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/close_profile_button"/>

    <TextView
        android:id="@+id/displayNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/display_name"
        android:textStyle="bold"
        android:textSize="20sp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/profilePic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        app:layout_constraintTop_toBottomOf="@+id/displayNameText"
        app:layout_constraintBottom_toTopOf="@id/statistics"/>

    <TextView
        android:id="@+id/statistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/statistics"
        android:drawablePadding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:textSize="18sp"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"
        android:layout_marginTop="20dp"
        app:drawableStartCompat="@drawable/ic_recent_progress"
        app:layout_constraintTop_toBottomOf="@id/displayNameText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_button_arrow"
        app:layout_constraintEnd_toEndOf="@id/statistics"
        app:layout_constraintTop_toTopOf="@id/statistics"
        app:layout_constraintBottom_toBottomOf="@id/statistics"/>

    <TextView
        android:id="@+id/history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history"
        android:drawablePadding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        app:drawableStartCompat="@drawable/ic_history"
        app:layout_constraintTop_toBottomOf="@id/statistics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_button_arrow"
        app:layout_constraintEnd_toEndOf="@id/history"
        app:layout_constraintTop_toTopOf="@id/history"
        app:layout_constraintBottom_toBottomOf="@id/history"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/log_out"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/log_out"
        android:textSize="15sp"
        android:backgroundTint="@color/primary"
        android:textColor="@color/on_primary"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/history"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>